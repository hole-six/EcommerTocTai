MONGODB_URI=mongodb://127.0.0.1:27017/toc_tai
MONGODB_DB=toc_tai
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAILS=admin@example.com

# SePay VietQR / webhook production settings
SEPAY_BANK=Vietcombank
SEPAY_ACCOUNT=your-bank-account-number
SEPAY_ACCOUNT_HOLDER=YOUR ACCOUNT HOLDER NAME
# Recommended: configure HMAC-SHA256 in SePay Dashboard and paste the secret here.
SEPAY_WEBHOOK_SECRET=replace-with-sepay-hmac-secret
# Optional fallback for SePay API-Key authentication (do not use together with HMAC in production).
SEPAY_WEBHOOK_API_KEY=
