{
  "name": "carewise",
  "version": "1.0.0",
  "private": true,
  "description": "CareWise (Tóc Tai) - nền tảng thương mại điện tử chăm sóc tóc & sức khỏe nam giới",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "seed:catalog": "node scripts/seed-full-catalog.mjs",
    "seed:banners": "node scripts/seed-banner-slots.mjs",
    "seed:orders": "node scripts/seed-orders.mjs",
    "seed:admin": "node scripts/seed-admin.mjs",
    "seed:local": "npm run seed:catalog && npm run seed:banners && npm run seed:admin"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.8",
    "lucide-react": "^1.6.0",
    "mongoose": "^9.9.2",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sepay-pg-node": "^1.0.0",
    "shadcn": "^4.1.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
