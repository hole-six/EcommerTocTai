# Cấu hình nginx cho CareWise — chạy song song hai tên miền.
#
# thuocmoctocchinhhang.com là miền chính (canonical): thẻ <link rel="canonical">
# do Next sinh ra luôn trỏ về miền này, nên Google gộp về một miền và hai miền
# không bị tính là nội dung trùng lặp.
#
# moctoc.vn phục vụ cùng một ứng dụng, KHÔNG redirect.
#
# Sau khi sửa file:
#   sudo nginx -t && sudo systemctl reload nginx
#
# Chứng chỉ TLS (nếu chưa bao gồm miền mới):
#   sudo certbot --nginx -d thuocmoctocchinhhang.com -d www.thuocmoctocchinhhang.com \
#                        -d moctoc.vn -d www.moctoc.vn

server {
    listen 80;
    listen [::]:80;
    server_name thuocmoctocchinhhang.com www.thuocmoctocchinhhang.com
                moctoc.vn www.moctoc.vn;

    # certbot chèn khối chuyển hướng sang HTTPS ở đây.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name thuocmoctocchinhhang.com www.thuocmoctocchinhhang.com
                moctoc.vn www.moctoc.vn;

    # Đường dẫn chứng chỉ do certbot quản lý — đừng sửa tay.
    # ssl_certificate     /etc/letsencrypt/live/thuocmoctocchinhhang.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/thuocmoctocchinhhang.com/privkey.pem;

    client_max_body_size 20m;

    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_cache_valid 200 60m;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /uploads/ {
        proxy_pass http://127.0.0.1:3000;
        add_header Cache-Control "public, max-age=86400";
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
